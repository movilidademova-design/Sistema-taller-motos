# ─────────────────────────────────────────────────────────────────────────────
# API — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. Este archivo SÍ se sube al
# repositorio; `.env` NO (está en .gitignore, verificado).
#
# NINGÚN valor de este archivo es un secreto real. Los campos marcados como
# OBLIGATORIO están vacíos a propósito: la aplicación debe fallar al arrancar si
# no los rellenas, en vez de arrancar con algo inseguro.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ BASES DE DATOS (obligatorias) ═══════════════════════════════════════════
# Son DOS bases distintas, a propósito. Ver DATABASE.md §1.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/taller_motos?schema=public"
POS_DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/motopos?schema=public"

# ═══ ENTORNO ═════════════════════════════════════════════════════════════════
# `production` desactiva la documentación Swagger y oculta los errores internos.
NODE_ENV=development
PORT=3001

# ═══ SECRETO DE SESIÓN (OBLIGATORIO) ═════════════════════════════════════════
# Genera uno NUEVO para cada entorno (desarrollo, staging, producción):
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# La API NO ARRANCA si está vacío, si tiene menos de 32 caracteres o si es un
# valor de ejemplo. Es deliberado: mejor un fallo ruidoso que un agujero mudo.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Cuánto dura la sesión antes de exigir iniciar sesión de nuevo.
#
# NOTA: aquí NO hay `JWT_REFRESH_SECRET`. El token de refresco no es un JWT: es
# un valor aleatorio opaco que se guarda hasheado con SHA-256 en la base, así
# que no hay nada que firmar. La variable existía en versiones anteriores de
# este archivo y NINGÚN código la leía — daba una falsa sensación de seguridad.
JWT_REFRESH_EXPIRES_IN=7d

# ═══ CORS (obligatorio en producción) ════════════════════════════════════════
# Dominio EXACTO del frontend, con protocolo y sin barra final.
# Varios separados por coma. Si esto está mal, el navegador bloquea TODAS las
# peticiones y la aplicación parece rota sin decir por qué.
CORS_ORIGIN=http://localhost:3000

# ═══ ENLACES PÚBLICOS ════════════════════════════════════════════════════════
# Base de las URLs que ve el cliente (el PDF de la cotización se envía por ahí).
# En producción, el dominio público de la API. NUNCA localhost.
PUBLIC_URL=http://localhost:3001

# ═══ ALMACENAMIENTO DE ARCHIVOS ══════════════════════════════════════════════
# `local` guarda en apps/api/uploads/ · `s3` usa S3 o Cloudflare R2.
STORAGE_DRIVER=local

# Sólo con STORAGE_DRIVER=s3. Las dos últimas SON SECRETOS.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=taller-motos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ═══ CORREO SALIENTE (opcional) ══════════════════════════════════════════════
# Si SMTP_HOST está vacío, el envío de correo queda DESACTIVADO y la aplicación
# lo dice claramente al intentar enviar (error 503 con explicación). No finge
# haber enviado nada.
# SMTP_PASSWORD ES UN SECRETO.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Taller Motos <no-reply@ejemplo.com>"

# ─────────────────────────────────────────────────────────────────────────────
# NO se incluyen aquí las variables WHATSAPP_*: ningún código las lee. El envío
# por WhatsApp se hace hoy abriendo WhatsApp Web con el mensaje ya escrito, sin
# ninguna integración de servidor.
# ─────────────────────────────────────────────────────────────────────────────
