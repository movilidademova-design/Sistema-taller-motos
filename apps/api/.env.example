DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taller_motos?schema=public"

NODE_ENV=development
PORT=3001

JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# S3 / Cloudflare R2 compatible object storage
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=taller-motos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# SMTP (email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Taller Motos <no-reply@tallermotos.com>"

# WhatsApp (prepared, not implemented - see WhatsappModule)
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
